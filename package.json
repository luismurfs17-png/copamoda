{
  "name": "copamoda",
  "private": true,
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "test": "npm run test --workspace backend",
    "build": "npm run build --workspace frontend",
    "migrate": "npm run migrate --workspace backend",
    "seed": "npm run seed --workspace backend",
    "format": "prettier --write \"backend/**/*.{js,json,yaml}\" \"frontend/src/**/*.{js,jsx,css}\" && eslint backend frontend --fix",
    "lint": "eslint backend frontend"
  },
  "devDependencies": { "@eslint/js": "^9.17.0", "concurrently": "^9.1.2", "eslint": "^9.17.0", "prettier": "^3.4.2" }
}
